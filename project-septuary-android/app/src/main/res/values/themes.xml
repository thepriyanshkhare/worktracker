        <item name="android:windowBackground">@color/septuary_bg</item>
        <item name="android:colorBackground">@color/septuary_bg</item>
        <item name="android:statusBarColor">@color/septuary_bg</item>
        <item name="android:navigationBarColor">@color/septuary_panel</item>
        <item name="android:colorAccent">@color/septuary_accent</item>
    </style>
</resources>
