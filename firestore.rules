rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every path is keyed by a private 20-character family code (100 bits of randomness)
    // generated on Priyansh's phone and shared only with his parents. The code is never in
    // this repository or in either app, so the data cannot be located without it. Both apps
    // also sign in with Firebase Anonymous Auth, so unauthenticated requests are refused.
    //
    // Collections cannot be listed by client apps, so knowing this rules file reveals nothing.

    function signedIn() {
      return request.auth != null;
    }

    function familyRoot(root) {
      return root.matches('sp_[A-Z2-7]{20}');
    }

    // Status + detail docs: written by Septuary, read by the Supervisor app. Small, so cap size.
    match /{root}/{docId} {
      allow get: if signedIn() && familyRoot(root) && docId in ['status', 'detail'];
      allow create, update: if signedIn() && familyRoot(root) && docId in ['status', 'detail']
                            && request.resource.data.size() < 20;
      allow delete: if false;
    }

    // Entries queued from the Claude chat (written with an admin key, which bypasses rules),
    // drained and deleted by the Septuary app.
    match /{inbox}/{entryId} {
      allow read, delete: if signedIn() && inbox.matches('sp_[A-Z2-7]{20}_inbox');
      allow create, update: if false;
    }

    // "Remind me" taps from the Supervisor app; drained and deleted by the Septuary app.
    match /{reminders}/{reminderId} {
      allow read, delete: if signedIn() && reminders.matches('sp_[A-Z2-7]{20}_reminders');
      allow create: if signedIn() && reminders.matches('sp_[A-Z2-7]{20}_reminders')
                    && request.resource.data.keys().hasOnly(['createdAt']);
      allow update: if false;
    }

    // One-time clean-up of the pre-pairing location (it appeared in this public repo).
    match /septuary_86800832c1af658f9d30a04276952c81/{docId} {
      allow delete: if signedIn();
      allow read, create, update: if false;
    }
  }
}
